        <DATE>2026-10-01</DATE>
      </DOC-REVISION>
    </DOC-REVISIONS>
  </ADMIN-DATA>
  <SW-SYSTEMS>
    <SW-SYSTEM>
      <SHORT-NAME>EDC42</SHORT-NAME>
      <SW-INSTANCE-SPEC>
        <SW-INSTANCE-TREE>
          <SHORT-NAME>EngineCalibration</SHORT-NAME>
          <CATEGORY>NO_VCD</CATEGORY>
          <SW-INSTANCE>
            <SHORT-NAME>K_IdleSpeed</SHORT-NAME>
            <CATEGORY>VALUE</CATEGORY>
            <SW-FEATURE-REF>F_Idle</SW-FEATURE-REF>
            <SW-VALUE-CONT>
              <UNIT-DISPLAY-NAME>rpm</UNIT-DISPLAY-NAME>
              <SW-VALUES-PHYS>
                <V>800</V>
              </SW-VALUES-PHYS>
            </SW-VALUE-CONT>
            <SW-CS-HISTORY>
              <CS-ENTRY>
                <STATE>checked</STATE>
                <DATE>2026-09-30</DATE>
                <CSUS>J. Doe</CSUS>
                <REMARK>raised for cold start</REMARK>
              </CS-ENTRY>
            </SW-CS-HISTORY>
          </SW-INSTANCE>
          <SW-INSTANCE>
            <SHORT-NAME>KL_IgnitionAdvance</SHORT-NAME>
            <CATEGORY>CURVE</CATEGORY>
            <SW-VALUE-CONT>
              <UNIT-DISPLAY-NAME>deg</UNIT-DISPLAY-NAME>
              <SW-ARRAYSIZE><V>4</V></SW-ARRAYSIZE>
              <SW-VALUES-PHYS>
                <V>5</V><V>10.5</V><V>18</V><V>24</V>
              </SW-VALUES-PHYS>
            </SW-VALUE-CONT>
            <SW-AXIS-CONTS>
              <SW-AXIS-CONT>
                <CATEGORY>STD_AXIS</CATEGORY>
                <UNIT-DISPLAY-NAME>rpm</UNIT-DISPLAY-NAME>
                <SW-ARRAYSIZE><V>4</V></SW-ARRAYSIZE>
                <SW-VALUES-PHYS>
                  <V>1000</V><V>2000</V><V>4000</V><V>6000</V>
                </SW-VALUES-PHYS>
              </SW-AXIS-CONT>
            </SW-AXIS-CONTS>
          </SW-INSTANCE>
          <SW-INSTANCE>
            <SHORT-NAME>KF_FuelMap</SHORT-NAME>
            <CATEGORY>MAP</CATEGORY>
            <SW-VALUE-CONT>
              <UNIT-DISPLAY-NAME>mg/stroke</UNIT-DISPLAY-NAME>
              <SW-ARRAYSIZE><V>2</V><V>3</V></SW-ARRAYSIZE>
              <SW-VALUES-PHYS>
                <VG><V>1.0</V><V>1.5</V><V>2.0</V></VG>
                <VG><V>2.5</V><V>3.0</V><V>3.25</V></VG>
              </SW-VALUES-PHYS>
            </SW-VALUE-CONT>
            <SW-AXIS-CONTS>
              <SW-AXIS-CONT>
                <CATEGORY>COM_AXIS</CATEGORY>
                <SW-INSTANCE-REF>AX_EngineSpeed</SW-INSTANCE-REF>
              </SW-AXIS-CONT>
              <SW-AXIS-CONT>
                <CATEGORY>FIX_AXIS</CATEGORY>
                <UNIT-DISPLAY-NAME>%</UNIT-DISPLAY-NAME>
                <SW-VALUES-PHYS><V>0</V><V>50</V><V>100</V></SW-VALUES-PHYS>
              </SW-AXIS-CONT>
            </SW-AXIS-CONTS>
          </SW-INSTANCE>
          <SW-INSTANCE>
            <SHORT-NAME>K_Mode</SHORT-NAME>
            <CATEGORY>VALUE</CATEGORY>
            <SW-VALUE-CONT>
              <SW-VALUES-PHYS><VT>Limp home</VT></SW-VALUES-PHYS>
            </SW-VALUE-CONT>
          </SW-INSTANCE>
          <SW-INSTANCE>
            <SHORT-NAME>T_Variant</SHORT-NAME>
            <CATEGORY>ASCII</CATEGORY>
            <SW-VALUE-CONT>
              <SW-VALUES-PHYS><VT>EU6 diesel</VT></SW-VALUES-PHYS>
            </SW-VALUE-CONT>
          </SW-INSTANCE>
          <SW-INSTANCE>
            <SHORT-NAME>KA_Offsets</SHORT-NAME>
            <CATEGORY>VAL_BLK</CATEGORY>
            <SW-VALUE-CONT>
              <SW-ARRAYSIZE><V>3</V></SW-ARRAYSIZE>
              <SW-VALUES-PHYS><V>-1</V><V>0</V><V>1</V></SW-VALUES-PHYS>
            </SW-VALUE-CONT>
          </SW-INSTANCE>
        </SW-INSTANCE-TREE>
      </SW-INSTANCE-SPEC>
    </SW-SYSTEM>
  </SW-SYSTEMS>
</MSRSW>
