{
  "schema_version": 1,
  "components": [
    {
      "name": "Engine",
      "process_arguments": [
        "--mode",
        "safe"
      ]
    },
    {
      "name": "Logger",
      "process_arguments": [
        "--verbose"
      ]
    }
  ],
  "run_targets": [
    {
      "name": "Drive",
      "depends_on": [
        "Engine",
        "Logger"
      ]
    },
    {
      "name": "Park",
      "depends_on": [
        "Logger"
      ]
    }
  ],
  "initial_run_target": "Park"
}
