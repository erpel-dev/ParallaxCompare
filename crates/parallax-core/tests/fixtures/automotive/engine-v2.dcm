KONSERVIERUNG_FORMAT 2.0
MODULKOPF "Dataset" "Engine"

FESTWERT K_IdleSpeed
  LANGNAME "Idle speed"
  EINHEIT_W "rpm"
  WERT 850
END

TEXTSTRING T_Variant
  LANGNAME "Vehicle variant"
  TEXT "EU6 diesel"
END

FESTWERTEBLOCK KA_Offsets 3
  EINHEIT_W "V"
  WERT 0.125 0.250 0.375
END

KENNLINIE KL_Advance 3
  EINHEIT_X "rpm"
  EINHEIT_W "deg"
  ST/X 1000 2000 3000
  WERT 5 10.5 18
END

KENNFELD KF_Fuel 3 2
  EINHEIT_X "rpm"
  EINHEIT_Y "%"
  EINHEIT_W "mg"
  ST/X 1000 2000 3000
  ST/Y 25
  WERT 1 2 3
  ST/Y 75
  WERT 4 5 6.5
END

STUETZSTELLENVERTEILUNG AX_Speed 3
  EINHEIT_X "rpm"
  ST/X 1000 2000 3000
END

GRUPPENKENNLINIE KL_Limit 3
  SSTX "AX_Speed"
  EINHEIT_W "Nm"
  WERT 100 150 125
END
