%YAML 1.2
---
# Text produced by the content views (document text, executable summary, hex dumps,
# GGUF models). Quantization types are coloured by bits per weight, so that a layer
# map reads like a heat map.
name: Parallax View
scope: text.parallax
hidden: true
contexts:
  main:
    - match: ^=== .* ===$
      scope: markup.heading.parallax entity.name.section.parallax
    - match: ^--- .* ---$
      scope: markup.heading.parallax entity.name.tag.parallax
    - match: ^! .*$
      scope: invalid.parallax markup.deleted.parallax
    - match: ^([0-9A-F]{8})(  )
      captures:
        1: constant.numeric.address.parallax
    - match: (\|)([^|]*)(\|)$
      captures:
        1: punctuation.parallax comment.parallax
        2: string.unquoted.parallax
        3: punctuation.parallax comment.parallax
    - match: \b0x[0-9a-fA-F]+\b
      scope: constant.numeric.hex.parallax
    - match: ^[A-Z][A-Za-z -]+:(?=\s)
      scope: keyword.other.parallax
    - match: \b(?:F32|F16|BF16|F64|I8|I16|I32|I64)\b
      scope: keyword.other.quant.float.parallax
    - match: \b(?:Q8_0|Q8_1|Q8_K)\b
      scope: entity.name.function.quant.q8.parallax
    - match: \b(?:Q5_0|Q5_1|Q5_K|Q6_K)\b
      scope: string.unquoted.quant.q5.parallax
    - match: \b(?:Q4_0|Q4_1|Q4_K|IQ4_NL|IQ4_XS|MXFP4)\b
      scope: constant.numeric.quant.q4.parallax
    - match: \b(?:Q2_K|Q3_K|IQ1_S|IQ1_M|IQ2_XXS|IQ2_XS|IQ2_S|IQ3_XXS|IQ3_S|TQ1_0|TQ2_0)\b
      scope: variable.language.quant.low.parallax
